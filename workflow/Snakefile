import os


configfile: "config/config.yaml"


OUTDIR = config["outdir"]
LOGDIR = os.path.join(OUTDIR, "logs")
BENCHDIR = os.path.join(OUTDIR, "benchmarks")

# ---- load sample sheet (sample,R1,R2; # comments ignored) ----
SAMPLES = {}
with open(config["samples_csv"]) as fh:
    for raw in fh:
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        parts = [p.strip() for p in line.split(",")]
        if len(parts) != 3:
            raise ValueError(f"Bad sample line (need sample,R1,R2): {raw!r}")
        s, r1, r2 = parts
        SAMPLES[s] = (r1, r2)

if not SAMPLES:
    raise ValueError(f"No samples parsed from {config['samples_csv']}")

# ---- optional caller outputs (declared only when enabled) ----
EXTRA_OUTPUTS = {
    "sv": ("enable_sv", ".sv.vcf.gz"),
    "cnv": ("enable_cnv", ".cnv.vcf.gz"),
    "repeats": ("enable_repeats", ".repeats.vcf.gz"),
}
# ---- gene-panel variant extraction paths ----
PANEL = config["panel_name"]
RESULTS = "results"
PANEL_BED = os.path.join(RESULTS, PANEL + "_genes.bed")
PANEL_VCF = os.path.join(RESULTS, PANEL + "_variants.vcf.gz")
PANEL_SITES = os.path.join(RESULTS, "annot", PANEL + "_sites.vcf.gz")
PANEL_JSON = os.path.join(RESULTS, "annot", PANEL + "_sites.json.gz")
PANEL_DB = os.path.join(RESULTS, PANEL + "_variants.sqlite")
PANEL_XLSX = os.path.join(RESULTS, PANEL + "_variants.xlsx")
PANEL_REPORT_MD = os.path.join(RESULTS, PANEL + "_report.md")
PANEL_REPORT = os.path.join(RESULTS, PANEL + "_report.pdf")
PIPELINE_REPORT_MD = os.path.join(RESULTS, "pipeline_report.md")
PIPELINE_REPORT = os.path.join(RESULTS, "pipeline_report.pdf")
SOMATIC_OUTDIR = config["somatic_outdir"]

# ---- analysis mode: must be chosen explicitly (no default) ----
# Set `mode:` in config/config.yaml or pass `--config mode=germline|tumor_only`.
MODES = ("germline", "tumor_only")
MODE = config.get("mode") or ""
if MODE not in MODES:
    raise ValueError(
        f"config 'mode' must be one of {MODES}, got {MODE!r}. Choose explicitly: "
        "set `mode:` in config/config.yaml or run with `--config mode=<mode>`."
    )
if MODE == "tumor_only" and config["enable_panel"]:
    raise ValueError(
        "enable_panel is not yet wired to tumor_only outputs (it reads the "
        "germline annotated VCFs); set enable_panel: false for tumor_only."
    )

MODE_VCFS = {
    "germline": os.path.join(OUTDIR, "{sample}", "{sample}.annotated.vcf.gz"),
    "tumor_only": os.path.join(
        SOMATIC_OUTDIR, "{sample}", "{sample}.hard-filtered.vcf.gz"
    ),
}
MODE_TARGETS = expand(MODE_VCFS[MODE], sample=SAMPLES) + (
    [PIPELINE_REPORT] if MODE == "germline" else []
)


def somatic_flags():
    """DRAGEN tumor-only flags; optional resources omitted when their path is empty."""
    c = config
    f = [f"--vc-target-vaf {c['vc_target_vaf']}"]
    if c["vc_systematic_noise"]:
        f.append(f"--vc-systematic-noise {c['vc_systematic_noise']}")
    f += [
        f"--variant-annotation-data {c['variant_annotation_data']}",
        "--vc-enable-germline-tagging true",
    ]
    if c["enable_somatic_sv"]:
        f.append("--enable-sv true")
        if c["sv_systematic_noise"]:
            f.append(f"--sv-systematic-noise {c['sv_systematic_noise']}")
    if c["enable_somatic_cnv"]:
        f.append("--enable-cnv true --cnv-enable-self-normalization true")
        if c["cnv_population_baf_vcf"]:
            f.append(f"--cnv-population-b-allele-vcf {c['cnv_population_baf_vcf']}")
        if c["enable_hrd"]:
            f.append("--enable-hrd true")
    if c["enable_tmb"]:
        f.append("--enable-tmb true --tmb-enable-proxi-filter true")
    if c["msi_microsatellites_file"]:
        f += [
            "--msi-command tumor-only",
            f"--msi-microsatellites-file {c['msi_microsatellites_file']}",
            f"--msi-coverage-threshold {c['msi_coverage_threshold']}",
        ]
        if c["msi_ref_normal"]:
            f.append(f"--msi-ref-normal-input {c['msi_ref_normal']}")
    return " ".join(f)


rule all:
    input:
        os.path.join(OUTDIR, "versions.yaml"),
        os.path.join(OUTDIR, "multiqc", "multiqc_report.html"),
        MODE_TARGETS,
        # gene-panel extraction only when enabled
        [PANEL_DB, PANEL_XLSX, PANEL_VCF, PANEL_REPORT]
        if config["enable_panel"]
        else [],


# Record live tool/reference versions for provenance.
rule versions:
    output:
        os.path.join(OUTDIR, "versions.yaml"),
    log:
        os.path.join(LOGDIR, "versions.log"),
    benchmark:
        os.path.join(BENCHDIR, "versions.tsv")
    params:
        dragen=config["dragen_bin"],
        nirvana=config["nirvana_bin"],
        ref=config["reference"],
    shell:
        r"""
        exec 2>{log} >{output}
        echo "dragen: \"$({params.dragen} --version 2>&1 | head -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')\""
        echo "ica: \"$({params.nirvana} --version 2>&1 | grep -oiE 'Annotations [0-9.]+' | grep -oE '[0-9.]+')\""
        echo "hashtable_version: \"$(grep -oE '\"hashtable_version\": \"[0-9]+\"' {params.ref}/info.json | grep -oE '[0-9]+' || echo NA)\""
        """


# DRAGEN germline WGS: map/align, dedup, small-variant calling over the whole
# genome, plus optional CNV / SV / repeat-expansion / PGx callers in the same
# run. Serialized via resources: dragen=1 (one FPGA job at a time).
rule dragen:
    input:
        r1=lambda wc: SAMPLES[wc.sample][0],
        r2=lambda wc: SAMPLES[wc.sample][1],
    output:
        **{
            k: os.path.join(OUTDIR, "{sample}", "{sample}" + suffix)
            for k, (flag, suffix) in EXTRA_OUTPUTS.items()
            if config[flag]
        },
        bam=os.path.join(OUTDIR, "{sample}", "{sample}.bam"),
        vcf=os.path.join(OUTDIR, "{sample}", "{sample}.hard-filtered.vcf.gz"),
    log:
        os.path.join(LOGDIR, "dragen", "{sample}.log"),
    benchmark:
        os.path.join(BENCHDIR, "dragen", "{sample}.tsv")
    resources:
        dragen=1,
    params:
        dragen=config["dragen_bin"],
        ref=config["reference"],
        rgid=config["rgid"],
        adapter_r1=config["trim_adapter_r1"],
        adapter_r2=config["trim_adapter_r2"],
        min_q=config["trim_min_quality"],
        min_len=config["trim_min_length"],
        vc_filter=config["vc_filter"],
        callers=" ".join(
            (
                ["--enable-cnv true --cnv-enable-self-normalization true"]
                if config["enable_cnv"]
                else []
            )
            + (["--enable-sv true"] if config["enable_sv"] else [])
            + (["--repeat-genotype-enable true"] if config["enable_repeats"] else [])
            + (
                ["--enable-targeted true --enable-star-allele true --enable-pgx true"]
                if config["enable_pgx"]
                else []
            )
            + (
                ["--vc-emit-ref-confidence GVCF --vc-enable-vcf-output true"]
                if config["emit_gvcf"]
                else []
            )
        ),
        outdir=lambda wc: os.path.join(OUTDIR, wc.sample),
    shell:
        r"""
        exec 2>{log}
        filter_arg=()
        if [ -n "{params.vc_filter}" ]; then
            filter_arg=(--vc-hard-filter "{params.vc_filter}")
        fi
        {params.dragen} -f \
            -r {params.ref} \
            -1 {input.r1} \
            -2 {input.r2} \
            --enable-variant-caller true \
            --enable-map-align true \
            --enable-map-align-output true \
            --output-format BAM \
            --RGID {params.rgid} \
            --RGSM {wildcards.sample} \
            --output-directory {params.outdir} \
            --output-file-prefix {wildcards.sample} \
            --remove-duplicates true \
            --read-trimmers adapter,quality \
            --trim-adapter-read1 {params.adapter_r1} \
            --trim-adapter-read2 {params.adapter_r2} \
            --trim-min-quality {params.min_q} \
            --trim-min-length {params.min_len} \
            {params.callers} \
            "${{filter_arg[@]}}"
        """


# DRAGEN somatic tumor-only WGS ("DNA Somatic Tumor-Only Solid WGS" recipe).
# Organoids have no matched normal: germline tagging against population DBs
# (--variant-annotation-data) stands in for the normal. Re-maps on the linear
# hashtable; SNV/indel + optional SV / CNV (+HRD) / TMB / MSI in one run.
# Serialized with the germline rule via resources: dragen=1.
rule dragen_somatic:
    input:
        r1=lambda wc: SAMPLES[wc.sample][0],
        r2=lambda wc: SAMPLES[wc.sample][1],
    output:
        vcf=os.path.join(SOMATIC_OUTDIR, "{sample}", "{sample}.hard-filtered.vcf.gz"),
    log:
        os.path.join(LOGDIR, "dragen_somatic", "{sample}.log"),
    benchmark:
        os.path.join(BENCHDIR, "dragen_somatic", "{sample}.tsv")
    resources:
        dragen=1,
    params:
        dragen=config["dragen_bin"],
        ref=config["somatic_reference"],
        rgid=config["rgid"],
        adapter_r1=config["trim_adapter_r1"],
        adapter_r2=config["trim_adapter_r2"],
        min_q=config["trim_min_quality"],
        min_len=config["trim_min_length"],
        noise=config["vc_systematic_noise"],
        flags=somatic_flags(),
        outdir=lambda wc: os.path.join(SOMATIC_OUTDIR, wc.sample),
    shell:
        r"""
        exec 2>{log}
        if [ ! -s "{params.noise}" ]; then
            echo "vc_systematic_noise unset or missing: required for tumor-only WGS" >&2
            exit 1
        fi
        mkdir -p {params.outdir}
        {params.dragen} -f \
            -r {params.ref} \
            --tumor-fastq1 {input.r1} \
            --tumor-fastq2 {input.r2} \
            --RGID-tumor {params.rgid} \
            --RGSM-tumor {wildcards.sample} \
            --output-directory {params.outdir} \
            --output-file-prefix {wildcards.sample} \
            --enable-map-align true \
            --enable-map-align-output true \
            --output-format BAM \
            --enable-sort true \
            --enable-duplicate-marking true \
            --enable-variant-caller true \
            --read-trimmers adapter,quality \
            --trim-adapter-read1 {params.adapter_r1} \
            --trim-adapter-read2 {params.adapter_r2} \
            --trim-min-quality {params.min_q} \
            --trim-min-length {params.min_len} \
            --enable-metrics-json true \
            {params.flags}
        """


# Nirvana annotation of the hard-filtered VCF (GRCh38), emitting an annotated VCF.
rule nirvana:
    input:
        vcf=os.path.join(OUTDIR, "{sample}", "{sample}.hard-filtered.vcf.gz"),
    output:
        vcf=os.path.join(OUTDIR, "{sample}", "{sample}.annotated.vcf.gz"),
    log:
        os.path.join(LOGDIR, "nirvana", "{sample}.log"),
    benchmark:
        os.path.join(BENCHDIR, "nirvana", "{sample}.tsv")
    params:
        bin=config["nirvana_bin"],
        cache=config["nirvana_cache"],
        dat=config["nirvana_dat"],
        sd=config["nirvana_sd"],
        fmt=config["nirvana_output_format"],
        out_prefix=lambda wc: os.path.join(OUTDIR, wc.sample, wc.sample + ".annotated"),
    shell:
        r"""
        exec 2>{log}
        {params.bin} -c {params.cache} -r {params.dat} --sd {params.sd} \
            --output-format {params.fmt} -i {input.vcf} -o {params.out_prefix}
        """


# Aggregate all DRAGEN QC into a single MultiQC report.
rule multiqc:
    input:
        vcfs=MODE_TARGETS,
        cfg="config/multiqc_config.yaml",
    output:
        os.path.join(OUTDIR, "multiqc", "multiqc_report.html"),
    log:
        os.path.join(LOGDIR, "multiqc.log"),
    benchmark:
        os.path.join(BENCHDIR, "multiqc.tsv")
    params:
        scan=OUTDIR,
        outdir=os.path.join(OUTDIR, "multiqc"),
    shell:
        r"""
        exec 2>{log}
        multiqc {params.scan} -c {input.cfg} -o {params.outdir} -n multiqc_report.html -f
        """


# ---- Gene-panel variant extraction (enable_panel; panel set by panel_csv / panel_name) ----
# Rules are always defined but only scheduled when rule all requests them.


# Look up panel symbols (col1 of panel_csv) in the GENCODE GTF, emit a padded,
# sorted, merged coordinate BED. Contigs are chr-prefixed (match the VCFs).
# The panel is a CSV whose later columns may be quoted and contain commas, so the
# gene set is taken by splitting each line on "," and keeping field 1 only.
rule panel_bed:
    input:
        gtf=config["gene_gtf"],
        csv=config["panel_csv"],
    output:
        bed=PANEL_BED,
    log:
        os.path.join(LOGDIR, "panel_bed.log"),
    benchmark:
        os.path.join(BENCHDIR, "panel_bed.tsv")
    params:
        pad=config["panel_gene_padding"],
    shell:
        r"""
        exec 2>{log}
        gawk -F'\t' -v PAD={params.pad} '
            NR==FNR {{
                sub(/\r$/,""); split($0, c, ",")
                if (c[1]!="" && c[1]!~/^#/ && c[1]!="gene_symbol") g[c[1]]=1
                next
            }}
            /^#/ {{ next }}
            $3=="gene" {{
                name=$9; sub(/.*gene_name "/,"",name); sub(/".*/,"",name)
                if (name in g) {{
                    s=$4-1-PAD; if (s<0) s=0; e=$5+PAD
                    print $1"\t"s"\t"e"\t"name
                }}
            }}' {input.csv} <(zcat {input.gtf}) \
            | sort -k1,1 -k2,2n \
            | bedtools merge -i - >{output.bed}
        test -s {output.bed}
        """


# Subset one sample's annotated VCF to the panel regions. -T streams (no index
# on the input needed); the annotated VCFs ship without a .tbi.
rule panel_subset:
    input:
        vcf=os.path.join(OUTDIR, "{sample}", "{sample}.annotated.vcf.gz"),
        bed=PANEL_BED,
    output:
        vcf=os.path.join(RESULTS, "panel_subsets", "{sample}." + PANEL + ".vcf.gz"),
        tbi=os.path.join(RESULTS, "panel_subsets", "{sample}." + PANEL + ".vcf.gz.tbi"),
    log:
        os.path.join(LOGDIR, "panel_subset", "{sample}.log"),
    benchmark:
        os.path.join(BENCHDIR, "panel_subset", "{sample}.tsv")
    shell:
        r"""
        exec 2>{log}
        bcftools view -T {input.bed} {input.vcf} -Oz -o {output.vcf}
        tabix -f -p vcf {output.vcf}
        """


# Merge per-sample panel subsets into one multi-sample VCF.
rule panel_merge:
    input:
        vcfs=expand(
            os.path.join(RESULTS, "panel_subsets", "{sample}." + PANEL + ".vcf.gz"),
            sample=SAMPLES,
        ),
    output:
        vcf=PANEL_VCF,
        tbi=PANEL_VCF + ".tbi",
    log:
        os.path.join(LOGDIR, "panel_merge.log"),
    benchmark:
        os.path.join(BENCHDIR, "panel_merge.tsv")
    shell:
        r"""
        exec 2>{log}
        bcftools merge -Oz -o {output.vcf} {input.vcfs}
        tabix -f -p vcf {output.vcf}
        """


# Sites-only VCF (drop genotypes) — the annotation payload is sample-independent,
# so we annotate the ~unique panel sites once instead of per sample.
rule panel_sites:
    input:
        vcf=PANEL_VCF,
    output:
        vcf=PANEL_SITES,
    log:
        os.path.join(LOGDIR, "panel_sites.log"),
    benchmark:
        os.path.join(BENCHDIR, "panel_sites.tsv")
    shell:
        r"""
        exec 2>{log}
        bcftools view -G {input.vcf} -Oz -o {output.vcf}
        """


# Nirvana JSON annotation of the panel sites (gnomAD, ClinVar, dbSNP, REVEL,
# phyloP, ...). json/vcf are mutually exclusive per Nirvana run, hence a
# separate pass from the per-sample `nirvana` rule.
rule panel_annotate:
    input:
        vcf=PANEL_SITES,
    output:
        json=PANEL_JSON,
    log:
        os.path.join(LOGDIR, "panel_annotate.log"),
    benchmark:
        os.path.join(BENCHDIR, "panel_annotate.tsv")
    params:
        bin=config["nirvana_bin"],
        cache=config["nirvana_cache"],
        dat=config["nirvana_dat"],
        sd=config["nirvana_sd"],
        out_prefix=os.path.join(RESULTS, "annot", PANEL + "_sites"),
    shell:
        r"""
        exec 2>{log}
        {params.bin} -c {params.cache} -r {params.dat} --sd {params.sd} \
            --output-format json -i {input.vcf} -o {params.out_prefix}
        """


# Build the queryable SQLite DB:
#   panel_variants        - one row per (variant, transcript-consequence, carrier
#                           sample); hom-ref/missing genotypes dropped.
#   variant_annotations   - one row per variant (vid): gnomAD AF, ClinVar, dbSNP,
#                           REVEL, phyloP.
#   panel_genes           - the curated panel CSV verbatim (category, priority,
#                           mechanism, key_variants, exome_capture_note).
#   panel_key_variants    - (gene, rsID) pairs parsed from key_variants; lets the
#                           cohort be matched against the a-priori variants by rsID.
#   panel_annotated (view)- panel_variants + annotations + gene metadata, with an
#                           is_key_variant flag.
#   key_variant_status    - one row per a-priori rsID: called or not, carrier counts.
#   key_variant_carriers  - the actual carrier rows for a-priori variants.
rule panel_db:
    input:
        vcf=PANEL_VCF,
        json=PANEL_JSON,
        csv=config["panel_csv"],
        script="src/panel_tables.py",
    output:
        db=PANEL_DB,
    log:
        os.path.join(LOGDIR, "panel_db.log"),
    benchmark:
        os.path.join(BENCHDIR, "panel_db.tsv")
    params:
        vtsv=os.path.join(RESULTS, PANEL + "_variants.tsv"),
        atsv=os.path.join(RESULTS, "annot", PANEL + "_annotations.tsv"),
        gtsv=os.path.join(RESULTS, "annot", PANEL + "_genes.tsv"),
        ktsv=os.path.join(RESULTS, "annot", PANEL + "_key_variants.tsv"),
    shell:
        r"""
        exec 2>{log}
        # panel metadata + a-priori (gene, rsID) pairs from the curated CSV
        python3 {input.script} {input.csv} {params.gtsv} {params.ktsv}

        # per-sample consequence rows (panel genes only, carriers only)
        bcftools +split-vep {input.vcf} -d \
            -f '[%CHROM\t%POS\t%REF\t%ALT\t%SAMPLE\t%GT\t%DP\t%GeneSymbol\t%GeneNcbiId\t%Feature\t%Canonical\t%Consequence\t%Impact\t%BioType\t%HGVSc\t%HGVSp\t%VariantId\n]' \
            | awk -F'\t' 'NR==FNR {{
                          sub(/\r$/,""); split($0, c, ",")
                          if (c[1]!="" && c[1]!~/^#/ && c[1]!="gene_symbol") g[c[1]]=1
                          next
                        }}
                        $6 !~ /^(0[\/|]0|\.[\/|]\.|\.)$/ && ($8 in g)' \
                {input.csv} - >{params.vtsv}

        # site-level annotations keyed by vid (== CSQ VariantId)
        zcat {input.json} | jq -r '
            .positions[].variants[]
            | [ .vid,
                (.dbsnp // [] | join(",")),
                (.gnomad.allAf // ""),
                (.gnomad.allHc // ""),
                ([.clinvar[]?.classifications.germlineClassification.classification]
                    | map(select(.)) | unique | join(";")),
                ([.clinvar[]?.classifications.germlineClassification.reviewStatus]
                    | map(select(.)) | unique | join(";")),
                ([.clinvar[]?.classifications.germlineClassification.conditions[]?.traits[]?.name.value]
                    | map(select(. and . != "not provided")) | unique | join(";")),
                (.revel.score // ""),
                (.phylopScore // "")
              ] | @tsv' \
            | awk -F'\t' '!seen[$1]++' >{params.atsv}

        rm -f {output.db}
        sqlite3 {output.db} <<'SQL'
CREATE TABLE panel_variants(
  chrom TEXT, pos INTEGER, ref TEXT, alt TEXT,
  sample TEXT, gt TEXT, dp INTEGER,
  gene_symbol TEXT, gene_ncbi_id TEXT, feature TEXT, canonical TEXT,
  consequence TEXT, impact TEXT, biotype TEXT, hgvsc TEXT, hgvsp TEXT,
  variant_id TEXT
);
CREATE TABLE variant_annotations(
  variant_id TEXT PRIMARY KEY, rsid TEXT, gnomad_af REAL, gnomad_hom INTEGER,
  clinvar_significance TEXT, clinvar_review TEXT, clinvar_conditions TEXT,
  revel REAL, phylop REAL
);
CREATE TABLE panel_genes(
  gene_symbol TEXT PRIMARY KEY, ensembl_gene_id TEXT, category TEXT, priority TEXT,
  mechanism TEXT, key_variants TEXT, evidence_note TEXT, exome_capture_note TEXT
);
CREATE TABLE panel_key_variants(
  gene_symbol TEXT, key_rsid TEXT, key_variant_note TEXT
);
.mode tabs
.import {params.vtsv} panel_variants
.import {params.atsv} variant_annotations
.import {params.gtsv} panel_genes
.import {params.ktsv} panel_key_variants
CREATE INDEX idx_gene   ON panel_variants(gene_symbol);
CREATE INDEX idx_sample ON panel_variants(sample);
CREATE INDEX idx_impact ON panel_variants(impact);
CREATE INDEX idx_vid    ON panel_variants(variant_id);
CREATE INDEX idx_krs    ON panel_key_variants(key_rsid);

-- rsid is a ','-joined dbSNP list, so match on a delimited substring, not equality:
-- ',rs123,' must not match ',rs1234,'.
CREATE VIEW panel_annotated AS
  SELECT v.*, a.rsid, a.gnomad_af, a.gnomad_hom,
         a.clinvar_significance, a.clinvar_review, a.clinvar_conditions,
         a.revel, a.phylop,
         CASE WHEN EXISTS (
           SELECT 1 FROM panel_key_variants k
           WHERE ',' || COALESCE(a.rsid, '') || ',' LIKE '%,' || k.key_rsid || ',%'
         ) THEN 1 ELSE 0 END AS is_key_variant,
         g.category AS gene_category,
         g.priority AS gene_priority,
         g.exome_capture_note
  FROM panel_variants v
  LEFT JOIN variant_annotations a USING(variant_id)
  LEFT JOIN panel_genes g ON g.gene_symbol = v.gene_symbol;

-- One row per a-priori rsID: was it called in this cohort, and in how many samples.
-- Rows with status 'not called' mean the site is absent from the cohort VCF — read
-- exome_capture_note before concluding anything (promoter/CNV sites are unrecoverable).
CREATE VIEW key_variant_status AS
  SELECT k.gene_symbol, k.key_rsid, k.key_variant_note,
         g.priority, g.category, g.exome_capture_note,
         CASE WHEN count(a.variant_id) = 0 THEN 'not called' ELSE 'called' END AS status,
         count(DISTINCT v.sample) AS n_carriers,
         count(DISTINCT CASE WHEN v.gt IN ('0/1','0|1','1|0') THEN v.sample END) AS n_het,
         count(DISTINCT CASE WHEN v.gt IN ('1/1','1|1')       THEN v.sample END) AS n_hom,
         max(a.gnomad_af) AS gnomad_af,
         group_concat(DISTINCT a.clinvar_significance) AS clinvar_significance
  FROM panel_key_variants k
  LEFT JOIN panel_genes g ON g.gene_symbol = k.gene_symbol
  LEFT JOIN variant_annotations a
         ON ',' || COALESCE(a.rsid, '') || ',' LIKE '%,' || k.key_rsid || ',%'
  LEFT JOIN panel_variants v ON v.variant_id = a.variant_id
  GROUP BY k.gene_symbol, k.key_rsid, k.key_variant_note
  ORDER BY (count(a.variant_id) = 0), k.gene_symbol;

-- Carrier-level detail for the a-priori variants: one row per (rsID x sample),
-- with the redundant Ensembl transcript rows collapsed.
CREATE VIEW key_variant_carriers AS
  SELECT k.gene_symbol, k.key_rsid, k.key_variant_note, g.priority,
         v.sample, max(v.gt) AS gt, max(v.dp) AS dp,
         v.chrom, v.pos, v.ref, v.alt,
         group_concat(DISTINCT v.consequence) AS consequence,
         group_concat(DISTINCT v.impact) AS impact,
         group_concat(DISTINCT NULLIF(v.hgvsp, '.')) AS hgvsp,
         a.gnomad_af, a.clinvar_significance, a.revel
  FROM panel_key_variants k
  JOIN variant_annotations a
    ON ',' || COALESCE(a.rsid, '') || ',' LIKE '%,' || k.key_rsid || ',%'
  JOIN panel_variants v
    ON v.variant_id = a.variant_id AND v.feature LIKE 'ENST%'
  LEFT JOIN panel_genes g ON g.gene_symbol = k.gene_symbol
  GROUP BY k.gene_symbol, k.key_rsid, v.sample, v.chrom, v.pos, v.ref, v.alt
  ORDER BY k.gene_symbol, k.key_rsid, v.sample;
SQL
        """


# Export every table/view of the panel DB to a multi-sheet .xlsx
# (panel_annotated first). Spreadsheet-friendly companion to the SQLite DB.
rule panel_xlsx:
    input:
        db=PANEL_DB,
        script="src/export_panel_xlsx.py",
    output:
        xlsx=PANEL_XLSX,
    log:
        os.path.join(LOGDIR, "panel_xlsx.log"),
    benchmark:
        os.path.join(BENCHDIR, "panel_xlsx.tsv")
    params:
        desc=config["panel_description"],
    shell:
        r"""
        exec 2>{log}
        python3 {input.script} {input.db} {output.xlsx} {PANEL} {params.desc:q}
        """


# Human-readable PDF report: overview, live summary stats, pipeline steps,
# and a column dictionary explaining every DB field / annotation. The script
# emits Markdown; pandoc (wkhtmltopdf engine, no LaTeX) renders it to PDF.
rule panel_report:
    input:
        db=PANEL_DB,
        json=PANEL_JSON,
        csv=config["panel_csv"],
        script="src/make_panel_report.sh",
    output:
        pdf=PANEL_REPORT,
        md=PANEL_REPORT_MD,
    log:
        os.path.join(LOGDIR, "panel_report.log"),
    benchmark:
        os.path.join(BENCHDIR, "panel_report.tsv")
    params:
        desc=config["panel_description"],
    shell:
        r"""
        exec 2>{log}
        bash {input.script} {PANEL} {input.db} {input.json} {input.csv} {output.md} {params.desc:q}
        pandoc {output.md} -o {output.pdf} \
            --pdf-engine=typst \
            -V fontsize=10pt
        """


# Human-readable PDF describing the whole analysis pipeline: inputs, per-step
# method, live tool/reference versions, and key outputs. Script emits Markdown;
# pandoc (typst engine) renders it to PDF.
rule pipeline_report:
    input:
        versions=os.path.join(OUTDIR, "versions.yaml"),
        samples=config["samples_csv"],
        script="src/make_pipeline_report.sh",
    output:
        pdf=PIPELINE_REPORT,
        md=PIPELINE_REPORT_MD,
    log:
        os.path.join(LOGDIR, "pipeline_report.log"),
    benchmark:
        os.path.join(BENCHDIR, "pipeline_report.tsv")
    params:
        outdir=OUTDIR,
        trim_q=config["trim_min_quality"],
        trim_len=config["trim_min_length"],
        cnv=config["enable_cnv"],
        sv=config["enable_sv"],
        repeats=config["enable_repeats"],
        pgx=config["enable_pgx"],
        gvcf=config["emit_gvcf"],
        panel=config["enable_panel"],
    shell:
        r"""
        exec 2>{log}
        bash {input.script} {params.outdir} {input.versions} {input.samples} \
            {params.trim_q} {params.trim_len} \
            {params.cnv} {params.sv} {params.repeats} {params.pgx} {params.gvcf} \
            {params.panel} {PANEL} {output.md}
        pandoc {output.md} -o {output.pdf} \
            --pdf-engine=typst \
            -V fontsize=10pt
        """
