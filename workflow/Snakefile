import os


configfile: "config/config.yaml"


# ---- analysis mode: must be chosen explicitly (no default) ----
# Set `mode:` in config/config.yaml or pass `--config mode=germline|tumor_only`.
MODES = ("germline", "tumor_only")
MODE = config.get("mode") or ""
if MODE not in MODES:
    raise ValueError(
        f"config 'mode' must be one of {MODES}, got {MODE!r}. Choose explicitly: "
        "set `mode:` in config/config.yaml or run with `--config mode=<mode>`."
    )

# ---- per-mode output roots ----
# Each mode writes its own tree (samples, logs, benchmarks, multiqc, versions)
# and its own results/<mode>/ directory, so the two never collide.
GERMLINE_OUTDIR = config["germline_outdir"]
SOMATIC_OUTDIR = config["somatic_outdir"]
MODE_ROOT = GERMLINE_OUTDIR if MODE == "germline" else SOMATIC_OUTDIR
LOGDIR = os.path.join(MODE_ROOT, "logs")
BENCHDIR = os.path.join(MODE_ROOT, "benchmarks")
RESULTS = os.path.join("results", "germline" if MODE == "germline" else "somatic")

# ---- load sample sheet (sample,R1,R2; # comments ignored) ----
SAMPLES = {}
with open(config["samples_csv"]) as fh:
    for raw in fh:
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        parts = [p.strip() for p in line.split(",")]
        if len(parts) != 3:
            raise ValueError(f"Bad sample line (need sample,R1,R2): {raw!r}")
        s, r1, r2 = parts
        SAMPLES[s] = (r1, r2)

if not SAMPLES:
    raise ValueError(f"No samples parsed from {config['samples_csv']}")

# ---- optional caller outputs (declared only when enabled) ----
EXTRA_OUTPUTS = {
    "sv": ("enable_sv", ".sv.vcf.gz"),
    "cnv": ("enable_cnv", ".cnv.vcf.gz"),
    "repeats": ("enable_repeats", ".repeats.vcf.gz"),
}
# ---- gene-panel variant extraction paths ----
PANEL = config["panel_name"]
PANEL_BED = os.path.join(RESULTS, PANEL + "_genes.bed")
PANEL_GENES_BED = os.path.join(RESULTS, PANEL + "_genes.named.bed")
PANEL_SUBSET = os.path.join(RESULTS, "panel_subsets", "{sample}." + PANEL + ".vcf.gz")
PANEL_CNV_TSV = os.path.join(RESULTS, "annot", PANEL + "_gene_cnv.tsv")
# tumor_only: the panel reads one calibration variant's calls
PANEL_CALIB = config["panel_calibration"]
PANEL_VCF = os.path.join(RESULTS, PANEL + "_variants.vcf.gz")
PANEL_SITES = os.path.join(RESULTS, "annot", PANEL + "_sites.vcf.gz")
PANEL_JSON = os.path.join(RESULTS, "annot", PANEL + "_sites.json.gz")
PANEL_DB = os.path.join(RESULTS, PANEL + "_variants.sqlite")
PANEL_XLSX = os.path.join(RESULTS, PANEL + "_variants.xlsx")
PANEL_REPORT_MD = os.path.join(RESULTS, PANEL + "_report.md")
PANEL_REPORT = os.path.join(RESULTS, PANEL + "_report.pdf")
PANEL_CLIENT = os.path.join(RESULTS, "client", PANEL + "_summary")
# tumor_only: genome-wide rare protein-altering candidates (client list)
CAND_DIR = os.path.join(RESULTS, "candidates")
CAND_OUT = os.path.join(RESULTS, "client", "somatic_candidates")
PIPELINE_REPORT_MD = os.path.join(RESULTS, "pipeline_report.md")
PIPELINE_REPORT = os.path.join(RESULTS, "pipeline_report.pdf")

CALIBS = config["somatic_calibrations"]
for _c in CALIBS:
    if _c not in ("default", "auto"):
        raise ValueError(
            f"somatic_calibrations entries must be default|auto, got {_c!r}"
        )
if MODE == "germline":
    MODE_TARGETS = expand(
        os.path.join(GERMLINE_OUTDIR, "{sample}", "{sample}.annotated.vcf.gz"),
        sample=SAMPLES,
    ) + [PIPELINE_REPORT]
else:
    MODE_TARGETS = expand(
        os.path.join(
            SOMATIC_OUTDIR, "{calib}", "{sample}", "{sample}.hard-filtered.vcf.gz"
        ),
        calib=CALIBS,
        sample=SAMPLES,
    )


def somatic_flags():
    """DRAGEN tumor-only flags; optional resources omitted when their path is empty."""
    c = config
    f = [f"--vc-target-vaf {c['vc_target_vaf']}"]
    if c["vc_systematic_noise"]:
        f.append(f"--vc-systematic-noise {c['vc_systematic_noise']}")
    f += [
        f"--variant-annotation-data {c['variant_annotation_data']}",
        "--vc-enable-germline-tagging true",
    ]
    if c["enable_somatic_sv"]:
        f.append("--enable-sv true")
        if c["sv_systematic_noise"]:
            f.append(f"--sv-systematic-noise {c['sv_systematic_noise']}")
    if c["enable_somatic_cnv"]:
        f.append("--enable-cnv true --cnv-enable-self-normalization true")
        if c["cnv_population_baf_vcf"]:
            f.append(f"--cnv-population-b-allele-vcf {c['cnv_population_baf_vcf']}")
        if c["enable_hrd"]:
            f.append("--enable-hrd true")
    if c["enable_tmb"]:
        f.append("--enable-tmb true --tmb-enable-proxi-filter true")
    if c["enable_msi"]:
        f += [
            "--msi-command tumor-only",
            f"--msi-microsatellites-file {c['msi_microsatellites_file']}",
            f"--msi-coverage-threshold {c['msi_coverage_threshold']}",
        ]
        if c["msi_ref_normal"]:
            f.append(f"--msi-ref-normal-input {c['msi_ref_normal']}")
    return " ".join(f)


rule all:
    input:
        os.path.join(MODE_ROOT, "versions.yaml"),
        os.path.join(MODE_ROOT, "multiqc", "multiqc_report.html"),
        MODE_TARGETS,
        # gene-panel extraction only when enabled
        [PANEL_DB, PANEL_XLSX, PANEL_VCF, PANEL_REPORT]
        if config["enable_panel"]
        else [],
        # short client summary (tumor_only panel only)
        [PANEL_CLIENT + ext for ext in (".xlsx", ".md", ".pdf")]
        + [CAND_OUT + ".xlsx", CAND_OUT + ".tsv"]
        if config["enable_panel"] and MODE == "tumor_only"
        else [],


# Record live tool/reference versions for provenance.
rule versions:
    output:
        os.path.join(MODE_ROOT, "versions.yaml"),
    log:
        os.path.join(LOGDIR, "versions.log"),
    benchmark:
        os.path.join(BENCHDIR, "versions.tsv")
    params:
        dragen=config["dragen_bin"],
        nirvana=config["nirvana_bin"],
        ref=config["reference"],
    shell:
        r"""
        exec 2>{log} >{output}
        echo "dragen: \"$({params.dragen} --version 2>&1 | head -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')\""
        echo "ica: \"$({params.nirvana} --version 2>&1 | grep -oiE 'Annotations [0-9.]+' | grep -oE '[0-9.]+')\""
        echo "hashtable_version: \"$(grep -oE '\"hashtable_version\": \"[0-9]+\"' {params.ref}/info.json | grep -oE '[0-9]+' || echo NA)\""
        """


# DRAGEN germline WGS: map/align, dedup, small-variant calling over the whole
# genome, plus optional CNV / SV / repeat-expansion / PGx callers in the same
# run. Serialized via resources: dragen=1 (one FPGA job at a time).
rule dragen:
    input:
        r1=lambda wc: SAMPLES[wc.sample][0],
        r2=lambda wc: SAMPLES[wc.sample][1],
    output:
        **{
            k: os.path.join(GERMLINE_OUTDIR, "{sample}", "{sample}" + suffix)
            for k, (flag, suffix) in EXTRA_OUTPUTS.items()
            if config[flag]
        },
        bam=os.path.join(GERMLINE_OUTDIR, "{sample}", "{sample}.bam"),
        vcf=os.path.join(GERMLINE_OUTDIR, "{sample}", "{sample}.hard-filtered.vcf.gz"),
    log:
        os.path.join(LOGDIR, "dragen", "{sample}.log"),
    benchmark:
        os.path.join(BENCHDIR, "dragen", "{sample}.tsv")
    resources:
        dragen=1,
    params:
        dragen=config["dragen_bin"],
        ref=config["reference"],
        rgid=config["rgid"],
        adapter_r1=config["trim_adapter_r1"],
        adapter_r2=config["trim_adapter_r2"],
        min_q=config["trim_min_quality"],
        min_len=config["trim_min_length"],
        vc_filter=config["vc_filter"],
        callers=" ".join(
            (
                ["--enable-cnv true --cnv-enable-self-normalization true"]
                if config["enable_cnv"]
                else []
            )
            + (["--enable-sv true"] if config["enable_sv"] else [])
            + (["--repeat-genotype-enable true"] if config["enable_repeats"] else [])
            + (
                ["--enable-targeted true --enable-star-allele true --enable-pgx true"]
                if config["enable_pgx"]
                else []
            )
            + (
                ["--vc-emit-ref-confidence GVCF --vc-enable-vcf-output true"]
                if config["emit_gvcf"]
                else []
            )
        ),
        outdir=lambda wc: os.path.join(GERMLINE_OUTDIR, wc.sample),
    shell:
        r"""
        exec 2>{log}
        filter_arg=()
        if [ -n "{params.vc_filter}" ]; then
            filter_arg=(--vc-hard-filter "{params.vc_filter}")
        fi
        {params.dragen} -f \
            -r {params.ref} \
            -1 {input.r1} \
            -2 {input.r2} \
            --enable-variant-caller true \
            --enable-map-align true \
            --enable-map-align-output true \
            --output-format BAM \
            --RGID {params.rgid} \
            --RGSM {wildcards.sample} \
            --output-directory {params.outdir} \
            --output-file-prefix {wildcards.sample} \
            --remove-duplicates true \
            --read-trimmers adapter,quality \
            --trim-adapter-read1 {params.adapter_r1} \
            --trim-adapter-read2 {params.adapter_r2} \
            --trim-min-quality {params.min_q} \
            --trim-min-length {params.min_len} \
            {params.callers} \
            "${{filter_arg[@]}}"
        """


# ---- tumor_only: align -> per-variant parameters -> call ----
# DRAGEN somatic tumor-only WGS ("DNA Somatic Tumor-Only Solid WGS" recipe),
# split in two DRAGEN passes so coverage-dependent parameters can be set from
# the sample's measured coverage (only known after mapping). Pass 1 is shared;
# pass 2 runs once per calibration variant in somatic_calibrations:
#   default -> DRAGEN defaults (callability 50, CNV bins 1 kb)
#   auto    -> callability threshold + CNV bin width scaled to coverage,
#              and COSMIC hotspots never tagged germline
SOMATIC_ALIGN = os.path.join(SOMATIC_OUTDIR, "align", "{sample}")
SOMATIC_CALLS = os.path.join(SOMATIC_OUTDIR, "{calib}", "{sample}")


wildcard_constraints:
    calib="default|auto",


# Pass 1: trim, map/align on the linear hashtable, sort, mark duplicates.
# Tumor input with no normal; no callers. Emits the tumor BAM + coverage metrics.
rule dragen_somatic_align:
    input:
        r1=lambda wc: SAMPLES[wc.sample][0],
        r2=lambda wc: SAMPLES[wc.sample][1],
    output:
        bam=os.path.join(SOMATIC_ALIGN, "{sample}_tumor.bam"),
        cov=os.path.join(SOMATIC_ALIGN, "{sample}.wgs_coverage_metrics.csv"),
    log:
        os.path.join(LOGDIR, "dragen_somatic_align", "{sample}.log"),
    benchmark:
        os.path.join(BENCHDIR, "dragen_somatic_align", "{sample}.tsv")
    resources:
        dragen=1,
    params:
        dragen=config["dragen_bin"],
        ref=config["somatic_reference"],
        rgid=config["rgid"],
        adapter_r1=config["trim_adapter_r1"],
        adapter_r2=config["trim_adapter_r2"],
        min_q=config["trim_min_quality"],
        min_len=config["trim_min_length"],
        outdir=lambda wc: SOMATIC_ALIGN.format(sample=wc.sample),
    shell:
        r"""
        exec 2>{log}
        mkdir -p {params.outdir}
        {params.dragen} -f \
            -r {params.ref} \
            --tumor-fastq1 {input.r1} \
            --tumor-fastq2 {input.r2} \
            --RGID-tumor {params.rgid} \
            --RGSM-tumor {wildcards.sample} \
            --output-directory {params.outdir} \
            --output-file-prefix {wildcards.sample} \
            --enable-map-align true \
            --enable-map-align-output true \
            --output-format BAM \
            --enable-sort true \
            --enable-duplicate-marking true \
            --enable-variant-caller false \
            --read-trimmers adapter,quality \
            --trim-adapter-read1 {params.adapter_r1} \
            --trim-adapter-read2 {params.adapter_r2} \
            --trim-min-quality {params.min_q} \
            --trim-min-length {params.min_len} \
            --enable-metrics-json true
        """


# Per-variant DRAGEN parameters from the measured median autosomal coverage.
#   auto:    vc-callability-tumor-thresh = clamp(round(frac * median), min, max)
#            cnv-interval-width = clamp(ceil_1kb(1000 * cnv_ref_cov / median),
#                                       1000, cnv_interval_width_max)
#            DRAGEN's defaults (50 reads, 1 kb bins) assume ~100x tumors; at
#            ~25x almost nothing is callable (TMB = 0) and CNV segmentation
#            aborts ("Autosomal median is too low").
#   default: no overrides (flags omitted).
# Writes <calib>/<sample>/<sample>.somatic_params.yaml; dragen_flags is the
# literal flag string pass 2 appends.
rule somatic_params:
    input:
        cov=os.path.join(SOMATIC_ALIGN, "{sample}.wgs_coverage_metrics.csv"),
    output:
        yaml=os.path.join(SOMATIC_CALLS, "{sample}.somatic_params.yaml"),
    log:
        os.path.join(LOGDIR, "somatic_params", "{calib}.{sample}.log"),
    params:
        frac=config["callability_fraction"],
        lo=config["callability_min"],
        hi=config["callability_max"],
        thresh_ov=config["callability_override"],
        ref_cov=config["cnv_ref_cov"],
        wmax=config["cnv_interval_width_max"],
        width_ov=config["cnv_interval_width_override"],
        cnv=int(config["enable_somatic_cnv"]),
    shell:
        r"""
        exec 2>{log}
        gawk -F, -v CALIB={wildcards.calib} -v F={params.frac} -v LO={params.lo} \
            -v HI={params.hi} -v TOV="{params.thresh_ov}" -v REF={params.ref_cov} \
            -v WMAX={params.wmax} -v WOV="{params.width_ov}" -v CNV={params.cnv} '
            $3 == "Median autosomal coverage over genome" {{ med = $4 }}
            END {{
                if (med == "" || med + 0 <= 0) {{
                    print "median autosomal coverage not found" > "/dev/stderr"; exit 1
                }}
                printf "calibration: %s\nmedian_cov: %s\n", CALIB, med
                if (CALIB == "default") {{
                    print "callability_thresh: \"\""
                    print "cnv_interval_width: \"\""
                    print "dragen_flags: \"\""
                    exit 0
                }}
                if (TOV != "") t = TOV + 0
                else {{
                    t = int(F * med + 0.5); if (t < LO) t = LO; if (t > HI) t = HI
                }}
                if (WOV != "") w = WOV + 0
                else {{
                    w = 1000 * REF / med; w = (w == int(w / 1000) * 1000) ? w : (int(w / 1000) + 1) * 1000
                    if (w < 1000) w = 1000; if (w > WMAX) w = WMAX
                }}
                flags = sprintf("--vc-callability-tumor-thresh %d --vc-germline-tag-hotspots false", t)
                if (CNV) flags = flags sprintf(" --cnv-interval-width %d", w)
                printf "callability_thresh: %d\ncnv_interval_width: %d\n", t, w
                printf "dragen_flags: \"%s\"\n", flags
            }}' {input.cov} >{output.yaml}
        """


# Pass 2: somatic calling from the shared pass-1 BAM (no re-mapping): SNV/indel
# with germline tagging + systematic noise, optional SV / CNV (+HRD) / TMB / MSI,
# plus the variant's dragen_flags. Serialized via dragen=1.
rule dragen_somatic:
    input:
        bam=os.path.join(SOMATIC_ALIGN, "{sample}_tumor.bam"),
        yaml=os.path.join(SOMATIC_CALLS, "{sample}.somatic_params.yaml"),
    output:
        vcf=os.path.join(SOMATIC_CALLS, "{sample}.hard-filtered.vcf.gz"),
    log:
        os.path.join(LOGDIR, "dragen_somatic", "{calib}.{sample}.log"),
    benchmark:
        os.path.join(BENCHDIR, "dragen_somatic", "{calib}.{sample}.tsv")
    resources:
        dragen=1,
    params:
        dragen=config["dragen_bin"],
        ref=config["somatic_reference"],
        noise=config["vc_systematic_noise"],
        flags=somatic_flags(),
        outdir=lambda wc: SOMATIC_CALLS.format(calib=wc.calib, sample=wc.sample),
    shell:
        r"""
        exec 2>{log}
        if [ ! -s "{params.noise}" ]; then
            echo "vc_systematic_noise unset or missing: required for tumor-only WGS" >&2
            exit 1
        fi
        extra=$(gawk -F'"' '/^dragen_flags:/ {{ print $2 }}' {input.yaml})
        echo "calibration={wildcards.calib} extra flags: $extra" >&2
        {params.dragen} -f \
            -r {params.ref} \
            --tumor-bam-input {input.bam} \
            --output-directory {params.outdir} \
            --output-file-prefix {wildcards.sample} \
            --enable-map-align false \
            --enable-variant-caller true \
            --enable-metrics-json true \
            {params.flags} \
            $extra
        """


# Nirvana annotation of the hard-filtered VCF (GRCh38), emitting an annotated VCF.
rule nirvana:
    input:
        vcf=os.path.join(GERMLINE_OUTDIR, "{sample}", "{sample}.hard-filtered.vcf.gz"),
    output:
        vcf=os.path.join(GERMLINE_OUTDIR, "{sample}", "{sample}.annotated.vcf.gz"),
    log:
        os.path.join(LOGDIR, "nirvana", "{sample}.log"),
    benchmark:
        os.path.join(BENCHDIR, "nirvana", "{sample}.tsv")
    params:
        bin=config["nirvana_bin"],
        cache=config["nirvana_cache"],
        dat=config["nirvana_dat"],
        sd=config["nirvana_sd"],
        fmt=config["nirvana_output_format"],
        out_prefix=lambda wc: os.path.join(
            GERMLINE_OUTDIR, wc.sample, wc.sample + ".annotated"
        ),
    shell:
        r"""
        exec 2>{log}
        {params.bin} -c {params.cache} -r {params.dat} --sd {params.sd} \
            --output-format {params.fmt} -i {input.vcf} -o {params.out_prefix}
        """


# Aggregate all DRAGEN QC into a single MultiQC report.
rule multiqc:
    input:
        vcfs=MODE_TARGETS,
        cfg="config/multiqc_config.yaml",
    output:
        os.path.join(MODE_ROOT, "multiqc", "multiqc_report.html"),
    log:
        os.path.join(LOGDIR, "multiqc.log"),
    benchmark:
        os.path.join(BENCHDIR, "multiqc.tsv")
    params:
        scan=MODE_ROOT,
        outdir=os.path.join(MODE_ROOT, "multiqc"),
    shell:
        r"""
        exec 2>{log}
        multiqc {params.scan} -c {input.cfg} -o {params.outdir} -n multiqc_report.html -f
        """


# ---- Gene-panel variant extraction (enable_panel; panel set by panel_csv / panel_name) ----
# Rules are always defined but only scheduled when rule all requests them.


# Look up panel symbols (col1 of panel_csv) in the GENCODE GTF, emit a padded,
# sorted, merged coordinate BED. Contigs are chr-prefixed (match the VCFs).
# The panel is a CSV whose later columns may be quoted and contain commas, so the
# gene set is taken by splitting each line on "," and keeping field 1 only.
rule panel_bed:
    input:
        gtf=config["gene_gtf"],
        csv=config["panel_csv"],
    output:
        bed=PANEL_BED,
        genes=PANEL_GENES_BED,
    log:
        os.path.join(LOGDIR, "panel_bed.log"),
    benchmark:
        os.path.join(BENCHDIR, "panel_bed.tsv")
    params:
        pad=config["panel_gene_padding"],
    shell:
        r"""
        exec 2>{log}
        gawk -F'\t' -v PAD={params.pad} '
            NR==FNR {{
                sub(/\r$/,""); split($0, c, ",")
                if (c[1]!="" && c[1]!~/^#/ && c[1]!="gene_symbol") g[c[1]]=1
                next
            }}
            /^#/ {{ next }}
            $3=="gene" {{
                name=$9; sub(/.*gene_name "/,"",name); sub(/".*/,"",name)
                if (name in g) {{
                    s=$4-1-PAD; if (s<0) s=0; e=$5+PAD
                    print $1"\t"s"\t"e"\t"name
                }}
            }}' {input.csv} <(zcat {input.gtf}) \
            | sort -k1,1 -k2,2n >{output.genes}
        bedtools merge -i {output.genes} >{output.bed}
        test -s {output.bed}
        """


# Panel subset per sample.
#   germline:   subset the genome-wide Nirvana-annotated VCF.
#   tumor_only: subset the raw somatic VCF of calibration variant
#               panel_calibration, then Nirvana-annotate only that subset
#               (minutes instead of annotating ~5M somatic records).
# -T streams (no index on the input needed).
if MODE == "germline":

    rule panel_subset:
        input:
            vcf=os.path.join(GERMLINE_OUTDIR, "{sample}", "{sample}.annotated.vcf.gz"),
            bed=PANEL_BED,
        output:
            vcf=PANEL_SUBSET,
            tbi=PANEL_SUBSET + ".tbi",
        log:
            os.path.join(LOGDIR, "panel_subset", "{sample}.log"),
        benchmark:
            os.path.join(BENCHDIR, "panel_subset", "{sample}.tsv")
        shell:
            r"""
            exec 2>{log}
            bcftools view -T {input.bed} {input.vcf} -Oz -o {output.vcf}
            tabix -f -p vcf {output.vcf}
            """

else:

    rule panel_subset_raw:
        input:
            vcf=os.path.join(
                SOMATIC_OUTDIR,
                PANEL_CALIB,
                "{sample}",
                "{sample}.hard-filtered.vcf.gz",
            ),
            bed=PANEL_BED,
        output:
            vcf=os.path.join(
                RESULTS, "panel_subsets", "{sample}." + PANEL + ".raw.vcf.gz"
            ),
        log:
            os.path.join(LOGDIR, "panel_subset_raw", "{sample}.log"),
        shell:
            r"""
            exec 2>{log}
            bcftools view -T {input.bed} {input.vcf} -Oz -o {output.vcf}
            """

    rule panel_subset:
        input:
            vcf=os.path.join(
                RESULTS, "panel_subsets", "{sample}." + PANEL + ".raw.vcf.gz"
            ),
        output:
            vcf=PANEL_SUBSET,
            tbi=PANEL_SUBSET + ".tbi",
        log:
            os.path.join(LOGDIR, "panel_subset", "{sample}.log"),
        benchmark:
            os.path.join(BENCHDIR, "panel_subset", "{sample}.tsv")
        params:
            bin=config["nirvana_bin"],
            cache=config["nirvana_cache"],
            dat=config["nirvana_dat"],
            sd=config["nirvana_sd"],
            out_prefix=lambda wc: PANEL_SUBSET.format(sample=wc.sample)[
                : -len(".vcf.gz")
            ],
        shell:
            r"""
            exec 2>{log}
            {params.bin} -c {params.cache} -r {params.dat} --sd {params.sd} \
                --output-format vcf -i {input.vcf} -o {params.out_prefix}
            tabix -f -p vcf {output.vcf}
            """

    # Copy ratio of every CNV segment overlapping each panel gene (calls of
    # panel_calibration). Tumor-only purity is often not estimated, so the
    # segment mean (SM, 1.0 = no change) is reported, not an integer CN.
    rule panel_cnv:
        input:
            cnv=expand(
                os.path.join(
                    SOMATIC_OUTDIR, PANEL_CALIB, "{sample}", "{sample}.cnv.vcf.gz"
                ),
                sample=SAMPLES,
            ),
            genes=PANEL_GENES_BED,
        output:
            tsv=PANEL_CNV_TSV,
        log:
            os.path.join(LOGDIR, "panel_cnv.log"),
        shell:
            r"""
            exec 2>{log}
            : >{output.tsv}
            for f in {input.cnv}; do
                s=$(bcftools query -l "$f")
                bcftools query -f '%CHROM\t%POS0\t%INFO/END\t%ALT\t%FILTER\t[%SM]\n' "$f" \
                    | bedtools intersect -wa -wb -a {input.genes} -b - \
                    | awk -F'\t' -v S="$s" 'BEGIN {{OFS="\t"}}
                        {{ alt = ($8 == "." ? "REF" : $8); gsub(/[<>]/, "", alt)
                           print $4, S, $5, $6, $7, alt, $9, $10 }}' >>{output.tsv}
            done
            """


# Merge per-sample panel subsets into one multi-sample VCF.
rule panel_merge:
    input:
        vcfs=expand(
            PANEL_SUBSET,
            sample=SAMPLES,
        ),
    output:
        vcf=PANEL_VCF,
        tbi=PANEL_VCF + ".tbi",
    log:
        os.path.join(LOGDIR, "panel_merge.log"),
    benchmark:
        os.path.join(BENCHDIR, "panel_merge.tsv")
    shell:
        r"""
        exec 2>{log}
        bcftools merge -Oz -o {output.vcf} {input.vcfs}
        tabix -f -p vcf {output.vcf}
        """


# Sites-only VCF (drop genotypes) — the annotation payload is sample-independent,
# so we annotate the ~unique panel sites once instead of per sample.
rule panel_sites:
    input:
        vcf=PANEL_VCF,
    output:
        vcf=PANEL_SITES,
    log:
        os.path.join(LOGDIR, "panel_sites.log"),
    benchmark:
        os.path.join(BENCHDIR, "panel_sites.tsv")
    shell:
        r"""
        exec 2>{log}
        bcftools view -G {input.vcf} -Oz -o {output.vcf}
        """


# Nirvana JSON annotation of the panel sites (gnomAD, ClinVar, dbSNP, REVEL,
# phyloP, ...). json/vcf are mutually exclusive per Nirvana run, hence a
# separate pass from the per-sample `nirvana` rule.
rule panel_annotate:
    input:
        vcf=PANEL_SITES,
    output:
        json=PANEL_JSON,
    log:
        os.path.join(LOGDIR, "panel_annotate.log"),
    benchmark:
        os.path.join(BENCHDIR, "panel_annotate.tsv")
    params:
        bin=config["nirvana_bin"],
        cache=config["nirvana_cache"],
        dat=config["nirvana_dat"],
        sd=config["nirvana_sd"],
        out_prefix=os.path.join(RESULTS, "annot", PANEL + "_sites"),
    shell:
        r"""
        exec 2>{log}
        {params.bin} -c {params.cache} -r {params.dat} --sd {params.sd} \
            --output-format json -i {input.vcf} -o {params.out_prefix}
        """


# Build the queryable SQLite DB:
#   panel_variants        - one row per (variant, transcript-consequence, carrier
#                           sample); hom-ref/missing genotypes dropped.
#   variant_annotations   - one row per variant (vid): gnomAD AF, ClinVar, dbSNP,
#                           REVEL, phyloP.
#   panel_genes           - the curated panel CSV verbatim (category, priority,
#                           mechanism, key_variants, exome_capture_note).
#   panel_key_variants    - (gene, rsID) pairs parsed from key_variants; lets the
#                           cohort be matched against the a-priori variants by rsID.
#   panel_annotated (view)- panel_variants + annotations + gene metadata, with an
#                           is_key_variant flag.
#   key_variant_status    - one row per a-priori rsID: called or not, carrier counts.
#   key_variant_carriers  - the actual carrier rows for a-priori variants.
rule panel_db:
    input:
        vcf=PANEL_VCF,
        subsets=expand(PANEL_SUBSET, sample=SAMPLES),
        cnv=[PANEL_CNV_TSV] if MODE == "tumor_only" else [],
        json=PANEL_JSON,
        csv=config["panel_csv"],
        script="src/panel_tables.py",
        json2tsv="src/nirvana_json_to_tsv.sh",
    output:
        db=PANEL_DB,
    log:
        os.path.join(LOGDIR, "panel_db.log"),
    benchmark:
        os.path.join(BENCHDIR, "panel_db.tsv")
    params:
        vtsv=os.path.join(RESULTS, PANEL + "_variants.tsv"),
        atsv=os.path.join(RESULTS, "annot", PANEL + "_annotations.tsv"),
        gtsv=os.path.join(RESULTS, "annot", PANEL + "_genes.tsv"),
        ktsv=os.path.join(RESULTS, "annot", PANEL + "_key_variants.tsv"),
        ctsv=PANEL_CNV_TSV if MODE == "tumor_only" else "/dev/null",
        mode=MODE,
        # germline VCFs have no GermlineStatus INFO tag
        gstatus="%INFO/GermlineStatus" if MODE == "tumor_only" else ".",
    shell:
        r"""
        exec 2>{log}
        # panel metadata + a-priori (gene, rsID) pairs from the curated CSV
        python3 {input.script} {input.csv} {params.gtsv} {params.ktsv}

        # per-sample consequence rows (panel genes only, carriers only). Read
        # each sample's subset (not the merge) so FILTER / GermlineStatus stay
        # per sample.
        for f in {input.subsets}; do
            bcftools +split-vep "$f" -d \
                -f '[%CHROM\t%POS\t%REF\t%ALT\t%SAMPLE\t%GT\t%DP\t%GeneSymbol\t%GeneNcbiId\t%Feature\t%Canonical\t%Consequence\t%Impact\t%BioType\t%HGVSc\t%HGVSp\t%VariantId\t%FILTER\t%AF\t{params.gstatus}\n]'
        done \
            | awk -F'\t' 'NR==FNR {{
                          sub(/\r$/,""); split($0, c, ",")
                          if (c[1]!="" && c[1]!~/^#/ && c[1]!="gene_symbol") g[c[1]]=1
                          next
                        }}
                        $6 !~ /^(0[\/|]0|\.[\/|]\.|\.)$/ && ($8 in g)' \
                {input.csv} - >{params.vtsv}

        # site-level annotations keyed by vid (== CSQ VariantId)
        bash {input.json2tsv} {input.json} >{params.atsv}

        rm -f {output.db}
        sqlite3 {output.db} <<'SQL'
CREATE TABLE panel_variants(
  chrom TEXT, pos INTEGER, ref TEXT, alt TEXT,
  sample TEXT, gt TEXT, dp INTEGER,
  gene_symbol TEXT, gene_ncbi_id TEXT, feature TEXT, canonical TEXT,
  consequence TEXT, impact TEXT, biotype TEXT, hgvsc TEXT, hgvsp TEXT,
  variant_id TEXT,
  filter TEXT, vaf REAL, germline_status TEXT
);
CREATE TABLE panel_gene_cnv(
  gene_symbol TEXT, sample TEXT, seg_chrom TEXT, seg_start INTEGER, seg_end INTEGER,
  cnv_call TEXT, cnv_filter TEXT, copy_ratio REAL
);
CREATE TABLE variant_annotations(
  variant_id TEXT PRIMARY KEY, rsid TEXT, gnomad_af REAL, gnomad_hom INTEGER,
  clinvar_significance TEXT, clinvar_review TEXT, clinvar_conditions TEXT,
  revel REAL, phylop REAL
);
CREATE TABLE panel_genes(
  gene_symbol TEXT PRIMARY KEY, ensembl_gene_id TEXT, category TEXT, priority TEXT,
  mechanism TEXT, key_variants TEXT, evidence_note TEXT, exome_capture_note TEXT
);
CREATE TABLE panel_key_variants(
  gene_symbol TEXT, key_rsid TEXT, key_variant_note TEXT
);
.mode tabs
.import {params.vtsv} panel_variants
.import {params.atsv} variant_annotations
.import {params.gtsv} panel_genes
.import {params.ktsv} panel_key_variants
.import {params.ctsv} panel_gene_cnv
CREATE INDEX idx_gene   ON panel_variants(gene_symbol);
CREATE INDEX idx_sample ON panel_variants(sample);
CREATE INDEX idx_impact ON panel_variants(impact);
CREATE INDEX idx_vid    ON panel_variants(variant_id);
CREATE INDEX idx_krs    ON panel_key_variants(key_rsid);

-- rsid is a ','-joined dbSNP list, so match on a delimited substring, not equality:
-- ',rs123,' must not match ',rs1234,'.
CREATE VIEW panel_annotated AS
  SELECT v.*, a.rsid, a.gnomad_af, a.gnomad_hom,
         a.clinvar_significance, a.clinvar_review, a.clinvar_conditions,
         a.revel, a.phylop,
         CASE WHEN EXISTS (
           SELECT 1 FROM panel_key_variants k
           WHERE ',' || COALESCE(a.rsid, '') || ',' LIKE '%,' || k.key_rsid || ',%'
         ) THEN 1 ELSE 0 END AS is_key_variant,
         g.category AS gene_category,
         g.priority AS gene_priority,
         g.exome_capture_note,
         g.mechanism AS gene_mechanism,
         CASE
           WHEN '{params.mode}' = 'germline' THEN 'germline call'
           WHEN v.germline_status LIKE 'Somatic%' THEN 'somatic'
           WHEN v.germline_status = 'Germline_Proxi'
             THEN 'unresolved (VAF-based germline tag; organoid ~100% tumor)'
           WHEN v.germline_status = 'Germline_DB' THEN 'likely germline (population DB)'
           ELSE 'untagged'
         END AS variant_class
  FROM panel_variants v
  LEFT JOIN variant_annotations a USING(variant_id)
  LEFT JOIN panel_genes g ON g.gene_symbol = v.gene_symbol;

-- Reviewer-facing summary: one row per (variant x sample) on the canonical
-- Ensembl transcript, PASS only, protein-altering (high/moderate impact), not
-- explained by a common population allele.
CREATE VIEW pathway_hits AS
  SELECT gene_symbol, gene_category AS pathway, gene_mechanism AS role, sample,
         chrom, pos, ref, alt, gt, dp, vaf, filter, germline_status, variant_class,
         consequence, impact, hgvsc, hgvsp, rsid, gnomad_af, clinvar_significance,
         revel, is_key_variant
  FROM panel_annotated
  WHERE filter = 'PASS' AND impact IN ('high', 'moderate')
    AND feature LIKE 'ENST%' AND canonical = 'True'
    AND variant_class <> 'likely germline (population DB)'
    AND (gnomad_af IS NULL OR gnomad_af = '' OR gnomad_af < 0.001)
  ORDER BY gene_category, gene_symbol, sample;

-- One row per a-priori rsID: was it called in this cohort, and in how many samples.
-- Rows with status 'not called' mean the site is absent from the cohort VCF — read
-- exome_capture_note before concluding anything (promoter/CNV sites are unrecoverable).
CREATE VIEW key_variant_status AS
  SELECT k.gene_symbol, k.key_rsid, k.key_variant_note,
         g.priority, g.category, g.exome_capture_note,
         CASE WHEN count(a.variant_id) = 0 THEN 'not called' ELSE 'called' END AS status,
         count(DISTINCT v.sample) AS n_carriers,
         count(DISTINCT CASE WHEN v.gt IN ('0/1','0|1','1|0') THEN v.sample END) AS n_het,
         count(DISTINCT CASE WHEN v.gt IN ('1/1','1|1')       THEN v.sample END) AS n_hom,
         max(a.gnomad_af) AS gnomad_af,
         group_concat(DISTINCT a.clinvar_significance) AS clinvar_significance
  FROM panel_key_variants k
  LEFT JOIN panel_genes g ON g.gene_symbol = k.gene_symbol
  LEFT JOIN variant_annotations a
         ON ',' || COALESCE(a.rsid, '') || ',' LIKE '%,' || k.key_rsid || ',%'
  LEFT JOIN panel_variants v ON v.variant_id = a.variant_id
  GROUP BY k.gene_symbol, k.key_rsid, k.key_variant_note
  ORDER BY (count(a.variant_id) = 0), k.gene_symbol;

-- Carrier-level detail for the a-priori variants: one row per (rsID x sample),
-- with the redundant Ensembl transcript rows collapsed.
CREATE VIEW key_variant_carriers AS
  SELECT k.gene_symbol, k.key_rsid, k.key_variant_note, g.priority,
         v.sample, max(v.gt) AS gt, max(v.dp) AS dp,
         v.chrom, v.pos, v.ref, v.alt,
         group_concat(DISTINCT v.consequence) AS consequence,
         group_concat(DISTINCT v.impact) AS impact,
         group_concat(DISTINCT NULLIF(v.hgvsp, '.')) AS hgvsp,
         a.gnomad_af, a.clinvar_significance, a.revel
  FROM panel_key_variants k
  JOIN variant_annotations a
    ON ',' || COALESCE(a.rsid, '') || ',' LIKE '%,' || k.key_rsid || ',%'
  JOIN panel_variants v
    ON v.variant_id = a.variant_id AND v.feature LIKE 'ENST%'
  LEFT JOIN panel_genes g ON g.gene_symbol = k.gene_symbol
  GROUP BY k.gene_symbol, k.key_rsid, v.sample, v.chrom, v.pos, v.ref, v.alt
  ORDER BY k.gene_symbol, k.key_rsid, v.sample;
SQL
        """


# Export every table/view of the panel DB to a multi-sheet .xlsx
# (panel_annotated first). Spreadsheet-friendly companion to the SQLite DB.
rule panel_xlsx:
    input:
        db=PANEL_DB,
        script="src/export_panel_xlsx.py",
    output:
        xlsx=PANEL_XLSX,
    log:
        os.path.join(LOGDIR, "panel_xlsx.log"),
    benchmark:
        os.path.join(BENCHDIR, "panel_xlsx.tsv")
    params:
        desc=config["panel_description"],
    shell:
        r"""
        exec 2>{log}
        python3 {input.script} {input.db} {output.xlsx} {PANEL} {params.desc:q}
        """


# Short client summary of the tumor-only panel: gene x sample matrix,
# alteration table, methods + limitations text (xlsx, one-page md / PDF).
# The full DB / xlsx stay the internal record.
if MODE == "tumor_only":

    rule panel_client_summary:
        input:
            db=PANEL_DB,
            params=expand(
                os.path.join(
                    SOMATIC_OUTDIR,
                    PANEL_CALIB,
                    "{sample}",
                    "{sample}.somatic_params.yaml",
                ),
                sample=SAMPLES,
            ),
            script="src/panel_client_summary.py",
        output:
            xlsx=PANEL_CLIENT + ".xlsx",
            md=PANEL_CLIENT + ".md",
            pdf=PANEL_CLIENT + ".pdf",
        log:
            os.path.join(LOGDIR, "panel_client_summary.log"),
        shell:
            r"""
            exec 2>{log}
            python3 {input.script} {input.db} {output.xlsx} {output.md} {input.params}
            pandoc {output.md} -o {output.pdf} \
                --pdf-engine=typst \
                -V fontsize=10pt -V margin-x=1.8cm -V margin-y=1.8cm
            """

    # Genome-wide candidate list (less curated than the panel summary).
    # PASS calls not tagged Germline_DB (~40-65k per sample) are Nirvana
    # annotated (CSQ per sample, JSON once for the merged sites), then filtered
    # to rare protein-altering calls by src/somatic_candidates.py.
    rule candidates_raw:
        input:
            vcf=os.path.join(
                SOMATIC_OUTDIR,
                PANEL_CALIB,
                "{sample}",
                "{sample}.hard-filtered.vcf.gz",
            ),
        output:
            vcf=os.path.join(CAND_DIR, "{sample}.raw.vcf.gz"),
            tbi=os.path.join(CAND_DIR, "{sample}.raw.vcf.gz.tbi"),
        log:
            os.path.join(LOGDIR, "candidates_raw", "{sample}.log"),
        shell:
            r"""
            exec 2>{log}
            bcftools view -f PASS -e 'INFO/GermlineStatus="Germline_DB"' \
                {input.vcf} -Oz -o {output.vcf}
            tabix -f -p vcf {output.vcf}
            """

    rule candidates_csq:
        input:
            vcf=os.path.join(CAND_DIR, "{sample}.raw.vcf.gz"),
        output:
            vcf=os.path.join(CAND_DIR, "{sample}.csq.vcf.gz"),
        log:
            os.path.join(LOGDIR, "candidates_csq", "{sample}.log"),
        benchmark:
            os.path.join(BENCHDIR, "candidates_csq", "{sample}.tsv")
        params:
            bin=config["nirvana_bin"],
            cache=config["nirvana_cache"],
            dat=config["nirvana_dat"],
            sd=config["nirvana_sd"],
            out_prefix=lambda wc: os.path.join(CAND_DIR, wc.sample + ".csq"),
        shell:
            r"""
            exec 2>{log}
            {params.bin} -c {params.cache} -r {params.dat} --sd {params.sd} \
                --output-format vcf -i {input.vcf} -o {params.out_prefix}
            """

    rule candidates_annotate:
        input:
            vcfs=expand(os.path.join(CAND_DIR, "{sample}.raw.vcf.gz"), sample=SAMPLES),
            tbis=expand(
                os.path.join(CAND_DIR, "{sample}.raw.vcf.gz.tbi"), sample=SAMPLES
            ),
        output:
            sites=os.path.join(CAND_DIR, "sites.vcf.gz"),
            json=os.path.join(CAND_DIR, "sites.json.gz"),
        log:
            os.path.join(LOGDIR, "candidates_annotate.log"),
        benchmark:
            os.path.join(BENCHDIR, "candidates_annotate.tsv")
        params:
            bin=config["nirvana_bin"],
            cache=config["nirvana_cache"],
            dat=config["nirvana_dat"],
            sd=config["nirvana_sd"],
            out_prefix=os.path.join(CAND_DIR, "sites"),
        shell:
            r"""
            exec 2>{log}
            bcftools merge {input.vcfs} | bcftools view -G -Oz -o {output.sites}
            {params.bin} -c {params.cache} -r {params.dat} --sd {params.sd} \
                --output-format json -i {output.sites} -o {params.out_prefix}
            """

    rule candidates_table:
        input:
            csq=expand(os.path.join(CAND_DIR, "{sample}.csq.vcf.gz"), sample=SAMPLES),
            raw=expand(os.path.join(CAND_DIR, "{sample}.raw.vcf.gz"), sample=SAMPLES),
            json=os.path.join(CAND_DIR, "sites.json.gz"),
            db=PANEL_DB,
            params=expand(
                os.path.join(
                    SOMATIC_OUTDIR,
                    PANEL_CALIB,
                    "{sample}",
                    "{sample}.somatic_params.yaml",
                ),
                sample=SAMPLES,
            ),
            json2tsv="src/nirvana_json_to_tsv.sh",
            script="src/somatic_candidates.py",
            helpers="src/panel_client_summary.py",
        output:
            xlsx=CAND_OUT + ".xlsx",
            tsv=CAND_OUT + ".tsv",
        log:
            os.path.join(LOGDIR, "candidates_table.log"),
        params:
            ctsv=os.path.join(CAND_DIR, "csq.tsv"),
            atsv=os.path.join(CAND_DIR, "annotations.tsv"),
            ntsv=os.path.join(CAND_DIR, "raw_counts.tsv"),
        shell:
            r"""
            exec 2>{log}
            for f in {input.csq}; do
                bcftools +split-vep "$f" -d \
                    -f '[%CHROM\t%POS\t%REF\t%ALT\t%SAMPLE\t%GT\t%DP\t%GeneSymbol\t%Feature\t%Canonical\t%Consequence\t%Impact\t%HGVSc\t%HGVSp\t%VariantId\t%FILTER\t%AF\t%INFO/GermlineStatus\t%INFO/CTB\n]'
            done >{params.ctsv}
            bash {input.json2tsv} {input.json} >{params.atsv}
            for f in {input.raw}; do
                printf '%s\t%s\n' "$(bcftools query -l "$f")" "$(bcftools view -H "$f" | wc -l)"
            done >{params.ntsv}
            python3 {input.script} {params.ctsv} {params.atsv} {params.ntsv} {input.db} \
                {output.xlsx} {output.tsv} {input.params}
            """


# Human-readable PDF report: overview, live summary stats, pipeline steps,
# and a column dictionary explaining every DB field / annotation. The script
# emits Markdown; pandoc (wkhtmltopdf engine, no LaTeX) renders it to PDF.
rule panel_report:
    input:
        db=PANEL_DB,
        json=PANEL_JSON,
        csv=config["panel_csv"],
        script="src/make_panel_report.sh",
    output:
        pdf=PANEL_REPORT,
        md=PANEL_REPORT_MD,
    log:
        os.path.join(LOGDIR, "panel_report.log"),
    benchmark:
        os.path.join(BENCHDIR, "panel_report.tsv")
    params:
        desc=config["panel_description"],
    shell:
        r"""
        exec 2>{log}
        bash {input.script} {PANEL} {input.db} {input.json} {input.csv} {output.md} {params.desc:q}
        pandoc {output.md} -o {output.pdf} \
            --pdf-engine=typst \
            -V fontsize=10pt
        """


# Human-readable PDF describing the whole analysis pipeline: inputs, per-step
# method, live tool/reference versions, and key outputs. Script emits Markdown;
# pandoc (typst engine) renders it to PDF.
rule pipeline_report:
    input:
        versions=os.path.join(MODE_ROOT, "versions.yaml"),
        samples=config["samples_csv"],
        script="src/make_pipeline_report.sh",
    output:
        pdf=PIPELINE_REPORT,
        md=PIPELINE_REPORT_MD,
    log:
        os.path.join(LOGDIR, "pipeline_report.log"),
    benchmark:
        os.path.join(BENCHDIR, "pipeline_report.tsv")
    params:
        outdir=GERMLINE_OUTDIR,
        trim_q=config["trim_min_quality"],
        trim_len=config["trim_min_length"],
        cnv=config["enable_cnv"],
        sv=config["enable_sv"],
        repeats=config["enable_repeats"],
        pgx=config["enable_pgx"],
        gvcf=config["emit_gvcf"],
        panel=config["enable_panel"],
    shell:
        r"""
        exec 2>{log}
        bash {input.script} {params.outdir} {input.versions} {input.samples} \
            {params.trim_q} {params.trim_len} \
            {params.cnv} {params.sv} {params.repeats} {params.pgx} {params.gvcf} \
            {params.panel} {PANEL} {output.md}
        pandoc {output.md} -o {output.pdf} \
            --pdf-engine=typst \
            -V fontsize=10pt
        """
